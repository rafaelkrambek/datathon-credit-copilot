{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "title": "Credit Underwriting Copilot — Observability",
  "tags": ["datathon", "credit", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "type": "stat",
      "title": "Total Requests",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(copilot_requests_total)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds"}}}
    },
    {
      "type": "stat",
      "title": "Requests OK / Blocked / Error",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [
        {"expr": "sum by (status) (copilot_requests_total)", "refId": "A", "legendFormat": "{{status}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "stat",
      "title": "Latencia p95 (s)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(copilot_request_latency_seconds_bucket[5m])))", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "decimals": 2}}
    },
    {
      "type": "stat",
      "title": "PII detectada (total)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(copilot_pii_detected_total)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Request rate por status (req/min)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "sum by (status) (rate(copilot_requests_total[1m])) * 60", "refId": "A", "legendFormat": "{{status}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Latencia p50 / p95 / p99 (s)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [
        {"expr": "histogram_quantile(0.5, sum by (le) (rate(copilot_request_latency_seconds_bucket[5m])))", "refId": "A", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(copilot_request_latency_seconds_bucket[5m])))", "refId": "B", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(copilot_request_latency_seconds_bucket[5m])))", "refId": "C", "legendFormat": "p99"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "barchart",
      "title": "Tool calls por tool",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "sum by (tool) (copilot_tool_calls_total)", "refId": "A", "legendFormat": "{{tool}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "barchart",
      "title": "PII por tipo de entidade",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 12},
      "targets": [
        {"expr": "sum by (entity_type) (copilot_pii_detected_total)", "refId": "A", "legendFormat": "{{entity_type}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "barchart",
      "title": "Guardrails bloqueados",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 12},
      "targets": [
        {"expr": "sum by (stage, severity) (copilot_guardrails_failed_total)", "refId": "A", "legendFormat": "{{stage}}/{{severity}}"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ]
}
